{
  "_comment": "Workstation (OpenPBS) sweep with SU2 from a podman image. Set execution.container.image (and su2_cfd/mpirun as paths inside the image) before 'prepare'; image null runs su2_cfd on the host. See docs/intake-euler/intake-sweep-pbs.md.",
  "name": "ramp4-m10-tr2.5-cr1.3",
  "output_root": "runs",
  "design": {
    "mach": 10.0,
    "temperature_ratio": 2.5,
    "stages": 4,
    "capture_height_m": 1.0,
    "contraction_ratio": 1.3,
    "duct_length_m": 3.0,
    "cowl_thickness_m": 0.057,
    "cowl_nose_length_m": 0.286,
    "upstream_length_m": 1.43
  },
  "sweep": {
    "mach": [8, 9, 10, 11, 12],
    "aoa_deg": [-4, -2, 0, 2, 4]
  },
  "execution": {
    "backend": "pbs",
    "ranks": 8,
    "su2_cfd": "SU2_CFD",
    "mpirun": ["mpirun", "-np", "{ranks}"],
    "python": "python3",
    "setup": [],
    "container": {
      "engine": "podman",
      "image": "localhost/su2:8.5.0",
      "options": ["--shm-size=2g", "--security-opt=label=disable"]
    },
    "pbs": {
      "queue": "calc_8p",
      "resources": ["select=1:ncpus=8:mpiprocs=8"],
      "job_prefix": "r4",
      "analysis_queue": null,
      "analysis_resources": ["select=1:ncpus=1"]
    }
  }
}
